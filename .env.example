# ============================================================================
# SUPABASE (Phase 0 - obligatoire dès le départ)
# ============================================================================
# Récupérer ces valeurs dans :
# Supabase Dashboard > Settings > API
# https://supabase.com/dashboard/project/<project-id>/settings/api

# URL du projet Supabase (format : https://xxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Clé publique anon (safe pour le client mobile, protégée par la RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Project ID (la partie xxx dans https://xxx.supabase.co)
# Utilisé pour générer les types TypeScript via supabase gen types
EXPO_PUBLIC_SUPABASE_PROJECT_ID=


# ============================================================================
# GOOGLE OAUTH (Phase 1 - pour le login Google)
# ============================================================================
# Créer un projet sur Google Cloud Console :
# https://console.cloud.google.com/
#
# Puis Credentials > OAuth 2.0 Client IDs :
# - Créer un client iOS (Application type: iOS)
# - Créer un client Android (Application type: Android, avec SHA-1)
# - Créer un client Web (utilisé par Supabase pour le callback)

EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=


# ============================================================================
# STRAVA OAUTH (Phase 3 - pour la preuve de séance via Strava)
# ============================================================================
# Créer une app sur https://www.strava.com/settings/api
#
# - Client ID : public, peut être côté client
# - Client Secret : PRIVÉ, ne JAMAIS mettre côté client
#   → Sera utilisé uniquement dans une Edge Function Supabase
#
# Voir docs Strava : https://developers.strava.com/docs/authentication/

EXPO_PUBLIC_STRAVA_CLIENT_ID=

# Strava Client Secret : à configurer côté Supabase Edge Function uniquement
# Voir docs/STRAVA_SETUP.md pour les détails (à créer en phase 3)


# ============================================================================
# EXPO (Phase 6 - pour les notifications push)
# ============================================================================
# Créer un compte sur https://expo.dev/
# Lier le projet via eas init
#
# Project ID se trouve dans app.config.ts ou app.json sous expo.extra.eas.projectId

EXPO_PUBLIC_EAS_PROJECT_ID=


# ============================================================================
# CONFIGURATION DE L'APP (optionnel mais utile)
# ============================================================================

# Environnement (development / staging / production)
EXPO_PUBLIC_APP_ENV=development

# Fuseau horaire par défaut pour le calcul des semaines
# Format IANA (ex: Europe/Paris)
EXPO_PUBLIC_DEFAULT_TIMEZONE=Europe/Paris

# Activer les logs détaillés (true en dev, false en prod)
EXPO_PUBLIC_ENABLE_DEBUG_LOGS=true


# ============================================================================
# TESTS E2E — SEED PRIVILÉGIÉ (optionnel, runner Playwright uniquement)
# ============================================================================
# Certains états ne peuvent être produits que côté serveur (cagnotte remplie,
# blâme, défi terminé, limite de séances…). Les specs E2E concernées les mettent
# en base directement avec la clé `service_role` (cf. e2e/helpers/seed.ts).
#
# ⚠ SECRET — accès TOTAL en écriture, bypasse la RLS. À mettre UNIQUEMENT dans
#   `.env` (gitignoré), JAMAIS de préfixe EXPO_PUBLIC_ : sans ce préfixe, Expo ne
#   l'inline pas dans le bundle client → elle ne vit que dans le runner Node.
#
# Récupérer : Supabase Dashboard > Settings > API > Project API keys > service_role
# Sans cette clé, les 7 specs de seed se `test.skip()` (la suite reste verte).
SUPABASE_SERVICE_ROLE_KEY=


